# Copy to .env and fill in. Never commit .env.

# TimeTree account — must be able to sign in with email + password.
# Google/Apple SSO-only accounts will not work; add a password in TimeTree settings first.
TIMETREE_EMAIL=
TIMETREE_PASSWORD=

# Google Cloud OAuth client (type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# TT2GCAL_STATE_DIR=./state
# TT2GCAL_CALENDAR_PREFIX=TimeTree ·
# Servers usually run in UTC; set this or new calendars are created in UTC.
# TT2GCAL_CALENDAR_TIMEZONE=Asia/Taipei
# Push endpoint for failure alerts, e.g. https://ntfy.sh/your-secret-topic
# TT2GCAL_ALERT_URL=
# TT2GCAL_INCLUDE_BIRTHDAYS=0
# TT2GCAL_INCLUDE_MEMOS=0
# TT2GCAL_LABEL_IN_DESCRIPTION=0
